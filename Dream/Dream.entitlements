<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Pages are written by Apple's larger model on Private Cloud Compute (AppleModels.swift). -->
	<key>com.apple.developer.private-cloud-compute</key>
	<true/>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>com.apple.developer.associated-domains</key>
	<!-- Debug builds add developer mode (DREAM_APPLINKS_MODE is "?mode=developer"), which fetches
	     the association file straight from the server. Release leaves it empty, so both entries
	     are the plain production one. -->
	<array>
		<string>applinks:$(DREAM_SHARE_HOST)</string>
		<string>applinks:$(DREAM_SHARE_HOST)$(DREAM_APPLINKS_MODE)</string>
	</array>
	<key>com.apple.developer.weatherkit</key>
	<true/>
</dict>
</plist>
