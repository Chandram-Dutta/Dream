<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).shared</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>dream</string>
			</array>
		</dict>
	</array>
	<key>DreamShareHost</key>
	<string>$(DREAM_SHARE_HOST)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>PostHogHost</key>
	<string>$(POSTHOG_HOST)</string>
	<key>PostHogKey</key>
	<string>$(POSTHOG_KEY)</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).page.*</string>
	</array>
	<key>DreamPrivateCloud</key>
	<string>$(DREAM_PRIVATE_CLOUD)</string>
</dict>
</plist>
