      {"name": "downPayment", "label": "Down payment", "role": "adjustable", "source": "", "symbol": "", "unit": "%", "format": "percent", "initial": 20, "min": 0, "max": 50, "step": 1, "options": []},
      {"name": "mortgageRate", "label": "Mortgage rate", "role": "adjustable", "source": "", "symbol": "", "unit": "", "format": "percent", "initial": 6.5, "min": 2, "max": 12, "step": 0.1, "options": []},
      {"name": "monthlyRent", "label": "Monthly rent", "role": "adjustable", "source": "", "symbol": "", "unit": "", "format": "number", "initial": 2200, "min": 500, "max": 10000, "step": 50, "options": []},
      {"name": "rentGrowth", "label": "Rent increase", "role": "adjustable", "source": "", "symbol": "", "unit": "", "format": "percent", "initial": 3, "min": 0, "max": 10, "step": 0.5, "options": []},
      {"name": "appreciation", "label": "Price growth", "role": "adjustable", "source": "", "symbol": "", "unit": "", "format": "percent", "initial": 5, "min": -5, "max": 15, "step": 0.5, "options": []},
      {"name": "years", "label": "Years", "role": "variable", "source": "", "symbol": "", "unit": "years", "format": "integer", "initial": 10, "min": 1, "max": 30, "step": 1, "options": []},
