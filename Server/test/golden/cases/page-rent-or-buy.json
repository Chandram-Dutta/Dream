    ],
    "outputs": [
      {"name": "rentCost", "label": "Cost of renting", "symbol": "", "unit": "", "formula": "monthlyRent * 12 * ((1 + rentGrowth / 100) ^ years - 1) / (rentGrowth / 100 + 0.000001)", "format": "currency"},
