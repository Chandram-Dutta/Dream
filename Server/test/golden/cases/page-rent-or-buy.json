      {"name": "difference", "label": "Buying saves", "symbol": "", "unit": "", "formula": "rentCost - buyCost", "format": "currency"},
      {"name": "buyIsBetter", "label": "Buy?", "symbol": "", "unit": "", "formula": "difference > 0", "format": "toggle"}
