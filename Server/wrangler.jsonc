{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dream-share",
  // Production links live on dream.onlychan.xyz; workers.dev keeps older links working.
  "routes": [{ "pattern": "dream.onlychan.xyz", "custom_domain": true }],
  "workers_dev": true,
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  // KaTeX's stylesheet and fonts, copied from node_modules, and the landing page, built from
  // ../Website (scripts/copy-website.mjs), before every dev run and deploy. Requests for files in
  // ./public are answered before the Worker runs, so "/" is the landing page.
  "build": { "command": "node scripts/copy-katex.mjs && node scripts/copy-website.mjs" },
  "assets": { "directory": "./public" },

  // Shared surfaces. Replace database_id with the id `npx wrangler d1 create dream-share` prints.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dream-share",
      "database_id": "0b42264b-ad3c-4da6-a5a3-188fb2ef5f1a",
      "migrations_dir": "migrations"
    }
  ],

  // Per-address limits, counted by Cloudflare and never stored by the Worker.
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "4801", "simple": { "limit": 10, "period": 60 } },
    { "name": "READ_LIMIT", "namespace_id": "4802", "simple": { "limit": 120, "period": 60 } },
    // Web search and page reads (src/web.ts), which cost money. A screen uses a few of each.
    { "name": "SEARCH_LIMIT", "namespace_id": "4803", "simple": { "limit": 30, "period": 60 } },
    { "name": "PAGE_LIMIT", "namespace_id": "4804", "simple": { "limit": 30, "period": 60 } },
    // Reports of shared pages (src/safety.ts), per address.
    { "name": "REPORT_LIMIT", "namespace_id": "4861", "simple": { "limit": 5, "period": 60 } },
    // Sync and photos (src/sync.ts), counted per signed-in person rather than per address.
    { "name": "SYNC_LIMIT", "namespace_id": "4851", "simple": { "limit": 300, "period": 60 } },
    // Per account (src/model.ts, src/attest.ts): a page takes a handful of model requests.
    { "name": "MODEL_LIMIT", "namespace_id": "4805", "simple": { "limit": 60, "period": 60 } },
    { "name": "ATTEST_LIMIT", "namespace_id": "4806", "simple": { "limit": 10, "period": 60 } },
    // Crash and hang reports (src/diagnostics.ts). A phone sends at most a few a day.
    { "name": "DIAGNOSTICS_LIMIT", "namespace_id": "4808", "simple": { "limit": 10, "period": 60 } }
  ],

  // Photos from synced pages (src/sync.ts), kept under <user id>/<photo id>. Create the bucket
  // once with `npx wrangler r2 bucket create dream-photos`.
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "dream-photos" }],

  // Workers AI, only for its gateway(): the model goes to xAI through Dream's AI Gateway
  // (src/model.ts), signed in as this account, so no gateway token is needed.
  "ai": { "binding": "AI" },

  // Pages made on the server (src/compose/, docs/ServerGeneration.md): one PageJob a page, which
  // keeps its request and event log in its own SQLite storage and runs the page on its alarm.
  "durable_objects": { "bindings": [{ "name": "PAGE_JOBS", "class_name": "PageJob" }] },
  // Durable Object classes as they change, applied in order on deploy, in every environment.
  "migrations": [{ "tag": "v1-page-jobs", "new_sqlite_classes": ["PageJob"] }],

  "vars": {
    // The apps that open /s/ links, as <Team ID>.<bundle ID>, separated by commas. Served in
    // /.well-known/apple-app-site-association; change it here when the app's ID changes.
    "APP_IDS": "DR99P625RR.xyz.onlychan.Dream",
    // Paid provider calls a day for everyone together, of each kind: searches, and page reads.
    // At Parallel's prices (fast search $1, extract $1 per 1,000) that's at most $4 a day.
    "WEB_DAILY_LIMIT": "2000",
    // Sign in with Apple (src/apple.ts): the audience of the app's identity tokens (its bundle ID),
    // and the team whose Sign in with Apple key revokes Apple's tokens when an account is deleted.
    "APPLE_CLIENT_ID": "xyz.onlychan.Dream",
    "APPLE_TEAM_ID": "DR99P625RR",
    // Dollars a day the model may cost for everyone together (src/usage.ts); past it, pages wait.
    "MODEL_DAILY_BUDGET": "100",
    // The AI Gateway model requests go through: logs off, no cache, provider keys required. Made
    // with `cf ai-gateway gateways create`; empty sends them straight to xAI.
    "AI_GATEWAY": "dream",
    // The models offered (src/models.ts), in Account's order; the first that isn't Dream Plus
    // only is everyone's default.
    "MODELS": "grok-4.7",
    // PostHog, for the server's own analytics events (src/analytics.ts), sent only for people who
    // turned on "Help improve Dream". The project key is public, like the app's; empty turns
    // server events off. The host is the US or EU cloud.
    "POSTHOG_KEY": "phc_tPZv7XGN6GCg95kK4HKDTMRyVTFzmEpSDfXgFF3LHrGT",
    "POSTHOG_HOST": "https://us.i.posthog.com"
    // Secrets, set with `wrangler secret put` (README.md), never here: PARALLEL_API_KEY, DREAM_APP_KEYS,
    // XAI_API_KEY, APPLE_KEY_ID and APPLE_PRIVATE_KEY, ADMIN_KEY (reviewing reported pages, src/safety.ts),
    // APNS_KEY, APNS_KEY_ID and APNS_TEAM_ID (notifications, src/push.ts; off until they're set), and
    // WEATHERKIT_KEY, WEATHERKIT_KEY_ID and WEATHERKIT_TEAM_ID (the weather from Apple Weather,
    // src/compose/weatherkit.ts; from Open-Meteo until they're set).
  },

  // Only what the Worker itself logs, which never includes addresses or surface content.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },

  // Fetches Apple's sign-in keys into D1 (src/accounts.ts, refreshAppleKeys). Each run may land
  // on a Cloudflare server Apple refuses, so it runs often enough for some to get through.
  "triggers": { "crons": ["17 */3 * * *"] },

  "env": {
    // A second Worker for trying changes before production: `npx wrangler deploy --env staging`.
    // It's dream-share-staging.<subdomain>.workers.dev, with no custom domain, and its own
    // database. Bindings aren't inherited from above, so each is repeated here; add new ones to
    // both. Secrets are set per environment, with `--env staging`.
    "staging": {
      "routes": [],
      "workers_dev": true,
      // Replace database_id with the id `npx wrangler d1 create dream-share-staging` prints.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dream-share-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": { "bindings": [{ "name": "PAGE_JOBS", "class_name": "PageJob" }] },
      // The same limits, counted apart from production's.
      "ratelimits": [
        { "name": "CREATE_LIMIT", "namespace_id": "5801", "simple": { "limit": 10, "period": 60 } },
        { "name": "READ_LIMIT", "namespace_id": "5802", "simple": { "limit": 120, "period": 60 } },
        { "name": "SEARCH_LIMIT", "namespace_id": "5803", "simple": { "limit": 30, "period": 60 } },
        { "name": "PAGE_LIMIT", "namespace_id": "5804", "simple": { "limit": 30, "period": 60 } },
        { "name": "DIAGNOSTICS_LIMIT", "namespace_id": "5808", "simple": { "limit": 10, "period": 60 } }
      ],
      "vars": {
        "APP_IDS": "DR99P625RR.xyz.onlychan.Dream",
        // Staging spends real money too, so a tenth of production's budget.
        "WEB_DAILY_LIMIT": "200",
        "POSTHOG_KEY": "",
        "POSTHOG_HOST": "https://us.i.posthog.com"
      }
    }
  }
}
