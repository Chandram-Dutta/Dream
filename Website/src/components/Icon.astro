---
// The few symbols the site needs, drawn to sit beside SF Symbols' weight. They take the text's
// color, or the accent where a page's title uses one.
interface Props {
  name: "eye" | "fork-knife" | "cart" | "pendulum" | "arrow-up" | "photo";
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === "eye" && (
    <>
      <path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z" />
      <circle cx="12" cy="12" r="3" />
    </>
  )}
  {name === "fork-knife" && (
    <>
      <path d="M5 3v5a2.5 2.5 0 0 0 5 0V3M7.5 3v18" />
      <path d="M18 21V3c-2.2 1.4-3.5 4-3.5 7.5V13H18" />
    </>
  )}
  {name === "cart" && (
    <>
      <path d="M2.5 4h2.6l2.3 10.5h10.3L20 7.5H6.2" />
      <circle cx="9" cy="19" r="1.4" />
      <circle cx="17" cy="19" r="1.4" />
    </>
  )}
  {name === "pendulum" && (
    <>
      <path d="M6 3.5h12M12 3.5l3.6 11.5" />
      <circle cx="16.4" cy="17.6" r="2.9" />
    </>
  )}
  {name === "arrow-up" && <path d="M12 19V5.5M6 11l6-6 6 6" stroke-width="2.6" />}
  {name === "photo" && (
    <>
      <rect x="3" y="4.5" width="18" height="15" rx="3.5" />
      <circle cx="9" cy="10" r="1.6" />
      <path d="m4 18 5-5 3.5 3.5L16 13l4 4" />
    </>
  )}
</svg>
