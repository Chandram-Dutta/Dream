---
import { GROCERIES } from "../../lib/demos";
import Icon from "../Icon.astro";

const left = GROCERIES.filter((item) => !item.done).length;
---

<article class="page" data-demo="groceries" data-accent="green" aria-label="This week's groceries">
  <div class="title-row form" style="--i: 0">
    <h2 class="title"><Icon name="cart" /><span class="voice">This week’s groceries</span></h2>
    <output class="left" data-out="left">{left} left</output>
  </div>
  <ul class="checklist form" style="--i: 1" data-list>
    {
      GROCERIES.map((item) => (
        <li>
          <button type="button" class="check" aria-pressed={item.done ? "true" : "false"}>
            <span class="box" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <path d="m6.5 12.5 3.5 3.5 7.5-8" />
              </svg>
            </span>
            <span class="name">{item.name}</span>
          </button>
        </li>
      ))
    }
  </ul>
  <form class="add form" style="--i: 2" data-add>
    <span class="plus" aria-hidden="true">+</span>
    <input type="text" name="item" placeholder="Add something" aria-label="Add something to the list" maxlength="40" autocomplete="off" enterkeyhint="done" />
  </form>
  <p class="note form" style="--i: 3">Lists stay with your pages, on every iPhone you sign in on.</p>
</article>
